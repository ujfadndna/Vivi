# 复制为 .env 后按需修改。所有后端默认 mock，可单独切换为 local / indextts / cloud。

# ── 工作区 ─────────────────────────────────────────────────
WORKSPACE_DIR=./workspace
DEFAULT_FPS=25
# 本地 Web 应用默认端口；启动脚本和 Docker Compose 默认使用 8100/5173
API_PORT=8100
WEB_ORIGIN=http://localhost:5173
# 接入模式：mock=无模型/无 key 可跑；remote=LLM/TTS/Render 通过 profile endpoint；local=按本机 .env 后端调用
DEPLOYMENT_MODE=mock
# Agent 层调用 /generate-text-only 时使用的默认数字人视频（需提前准备）
DEFAULT_AVATAR_VIDEO=./workspace/avatar/default.mp4
# /chat 页面待机循环视频；不存在时自动回退到 DEFAULT_AVATAR_IMAGE
DEFAULT_IDLE_VIDEO=./workspace/avatar/idle.mp4
# FlashHead 单图驱动使用的头像参考图；真实 FlashHead 后端必须配置为正确图片
DEFAULT_AVATAR_IMAGE=./workspace/avatar/default.png
# Profile 首次启动会从 DEFAULT_AVATAR_IMAGE / DEFAULT_SPEAKER_WAV / INDEXTTS_API_URL /
# AGENT_LLM_* 迁移默认 profile；之后运行时配置保存在 workspace/profiles/
DEFAULT_SPEAKER_WAV=./reference_voice.wav

# ── 模型后端选择（mock | local | indextts | indextts_http | qwen3 | cloud）─────────
INGEST_BACKEND=mock
TTS_BACKEND=mock
MUSETALK_BACKEND=mock
SEGMENT_BACKEND=mock
BACKGROUND_BACKEND=mock
COMPOSITE_BACKEND=local        # 合成走真实 ffmpeg（imageio-ffmpeg 自带）

# MuseTalk 真实后端（可选）：默认使用 third_party/MuseTalk 和项目根 models
# MUSETALK_BACKEND=local
# MUSETALK_REPO=./third_party/MuseTalk
# MUSETALK_MODELS_DIR=./models

# RVM 真实分割后端（可选）：启用前先按 requirements-segment.txt 安装依赖并准备权重
# SEGMENT_BACKEND=local
# RVM_VARIANT=mobilenetv3
# RVM_CHECKPOINT=./models/rvm/rvm_mobilenetv3.pth
# 或使用 torch.hub 自动下载（需要网络访问 github.com/PeterL1n/RobustVideoMatting）：
# SEGMENT_BACKEND=rvm  # (alias: same as local, backend key registered as "local")

# IndexTTS2 真实 TTS 后端（可选）：启用前先按 requirements-tts-indextts.txt 准备官方仓库和权重。
# TTS_BACKEND=indextts 启用；8GB 卡建议 FP16 省显存。
# TTS_BACKEND=indextts
# INDEXTTS_REPO=./third_party/IndexTTS
# INDEXTTS_CHECKPOINTS=./models/IndexTTS-2
# INDEXTTS_USE_FP16=true
# INDEXTTS_USE_DEEPSPEED=false
# 如使用独立 IndexTTS2 HTTP 服务，改用：
# TTS_BACKEND=indextts_http
# INDEXTTS_API_URL=http://127.0.0.1:8200

# ── Celery / Redis ─────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# 无 Redis 时设为 true：任务同步执行，方便本地 demo
CELERY_TASK_ALWAYS_EAGER=true

# MVP-2 low-latency switches
SKIP_RVM=true
MUSETALK_REALTIME_BLEND=true
MUSETALK_STREAM_FRAMES=true
MUSETALK_PERSISTENT_WORKER=true

# Agent LLM provider: anthropic | openai | deepseek
AGENT_LLM_PROVIDER=deepseek
AGENT_LLM_MODEL=deepseek-chat
# AGENT_LLM_API_KEY=sk-...
# AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
